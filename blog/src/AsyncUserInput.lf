target C {
  keepalive: true
}

reactor UserInput {
  preamble {=
    #include <stdio.h>
    #include <stdlib.h>
  =}
  timer t(0, 5 s)
  output out: char*
  state count: int
  physical action awake

  reaction(startup, awake) -> out, awake {=
    lf_print("Control-D to exit.");
    while (true) {
      char* line = NULL;
      size_t capacity = 0;
      int nread = lf_async(awake, getline, &line, &capacity, stdin);
      if (nread < 0) {
        lf_print("User input: EOF");
        free(line);
        lf_request_stop();
        break;
      }
      if (nread > 0 && line[nread - 1] == '\n') {
        line[nread - 1] = '\0';
      }
      lf_set(out, line);
    }
  =}

  reaction(t) -> out {=
    char* prompt = NULL;
    asprintf(&prompt, "%d: Waiting for input...", self->count++);
    lf_set(out, prompt);
  =}
}

main reactor {
  user_input = new UserInput()

  reaction(user_input.out) {=
    lf_print("At logical time " PRINTF_TIME ", Line: %s", lf_time_logical_elapsed(), user_input.out->value);
  =}
}
